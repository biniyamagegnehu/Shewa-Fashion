# Shewa Fashion — Environment Variables Example
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#   # Then edit .env.local with your real values.
#
# ============================================================
# Database (Prisma / PostgreSQL)
# ============================================================

# Primary connection URL for Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (local):
#   DATABASE_URL="postgresql://postgres:mypassword@localhost:5432/shewa_fashion"
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/shewa_fashion"

# DIRECT_URL is required when using a connection pooler (e.g. PgBouncer
# on Vercel Postgres / Supabase) so that Prisma Migrate can bypass the
# pooler for DDL operations.  Leave unset for a plain local PostgreSQL
# connection where DATABASE_URL talks directly to PostgreSQL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ============================================================
# Admin Authentication (Phase 10)
# ============================================================

# Secret key used to sign and encrypt admin session tokens (HS256).
# Generate with: openssl rand -base64 32 (or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Do NOT use this placeholder value in production.
SESSION_SECRET="replace-with-a-secure-random-secret-generate-with-openssl-rand-base64-32"
