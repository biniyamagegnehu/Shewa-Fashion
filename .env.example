# Shewa Fashion — Environment Variables Example
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#   # Then edit .env.local with your real values.
#
# ============================================================
# Database (Prisma / PostgreSQL)
# ============================================================

# Primary connection URL for Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (local):
#   DATABASE_URL="postgresql://postgres:mypassword@localhost:5432/shewa_fashion"
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/shewa_fashion"

# DIRECT_URL is required when using a connection pooler (e.g. PgBouncer
# on Vercel Postgres / Supabase) so that Prisma Migrate can bypass the
# pooler for DDL operations. Leave unset for a plain local PostgreSQL
# connection where DATABASE_URL talks directly to PostgreSQL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ============================================================
# Admin Authentication (Phase 10: Server-Side Opaque Sessions)
# ============================================================
# Opaque sessions are persisted directly in PostgreSQL with SHA-256
# token hashes (no external token signing secret is required).
#
# Initial Administrator Provisioning (Optional / Operational):
# Used non-interactively with `npm run create-admin`:
#   ADMIN_NAME="Administrator"
#   ADMIN_EMAIL="admin@shewafashion.com"
#   ADMIN_PASSWORD="a-strong-password-at-least-8-chars"
#

# ============================================================
# Object Storage (Phase 12: Product Image Uploads)
# Compatible with Cloudflare R2, AWS S3, or any S3-compatible provider.
# All credentials are kept server-side and never exposed to clients.
# ============================================================
STORAGE_BUCKET="shewa-fashion-products"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Custom endpoint (required for Cloudflare R2 / MinIO; leave blank for standard AWS S3):
# Example (Cloudflare R2): https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""
# Public asset CDN/URL (optional; if set, used for stored image URLs):
# Example (Cloudflare R2 public URL / custom domain): https://images.shewafashion.com
STORAGE_PUBLIC_URL=""

# Alternative: Vercel Blob token (if deploying on Vercel with Vercel Blob):
# BLOB_READ_WRITE_TOKEN=""

