# Shewa Fashion — Environment Variables Example
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#   # Then edit .env.local with your real values.
#
# ============================================================
# Database (Prisma / PostgreSQL)
# ============================================================

# Primary connection URL for Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (local):
#   DATABASE_URL="postgresql://postgres:mypassword@localhost:5432/shewa_fashion"
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/shewa_fashion"

# DIRECT_URL is required when using a connection pooler (e.g. PgBouncer
# on Vercel Postgres / Supabase) so that Prisma Migrate can bypass the
# pooler for DDL operations. Leave unset for a plain local PostgreSQL
# connection where DATABASE_URL talks directly to PostgreSQL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ============================================================
# Admin Authentication (Phase 10: Server-Side Opaque Sessions)
# ============================================================
# Opaque sessions are persisted directly in PostgreSQL with SHA-256
# token hashes (no external token signing secret is required).
#
# Initial Administrator Provisioning (Optional / Operational):
# Used non-interactively with `npm run create-admin`:
#   ADMIN_NAME="Administrator"
#   ADMIN_EMAIL="admin@shewafashion.com"
#   ADMIN_PASSWORD="a-strong-password-at-least-8-chars"
#

# ============================================================
# Production-Ready Object Storage (Phase 15: Unified Image Uploads)
# ============================================================
# The shared storage layer persists Product images, Lookbook Gallery photos,
# and Store Logos. Credentials are strictly server-side and never exposed.
#
# Supported Providers:
#   1. Cloudflare R2 (Recommended: zero egress fees, fast global CDN)
#   2. AWS S3 (Standard S3 bucket with SigV4 authentication)
#   3. MinIO / Wasabi / Backblaze B2 (Any S3-compatible object store)
#   4. Vercel Blob (Zero-config token for Vercel deployments)
#
# ------------------------------------------------------------
# Option A: S3-Compatible Storage (AWS S3, Cloudflare R2, MinIO)
# ------------------------------------------------------------
# Name of your target storage bucket
STORAGE_BUCKET="shewa-fashion-assets"

# Region: use "auto" for Cloudflare R2, or AWS region (e.g. "us-east-1", "eu-central-1")
STORAGE_REGION="auto"

# Access Key ID (from Cloudflare R2 API Tokens or AWS IAM)
STORAGE_ACCESS_KEY_ID=""

# Secret Access Key (never commit to git or expose in browser)
STORAGE_SECRET_ACCESS_KEY=""

# Custom Endpoint:
# - Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# - MinIO (local dev): http://localhost:9000
# - AWS S3: Leave empty (defaults to standard AWS S3 endpoint)
STORAGE_ENDPOINT=""

# Public Asset Delivery URL:
# - Cloudflare R2 Public Bucket: https://pub-<hash>.r2.dev or custom domain https://images.shewafashion.com
# - AWS S3 CloudFront: https://<distribution-id>.cloudfront.net
# - AWS S3 Direct: https://shewa-fashion-assets.s3.amazonaws.com
# - Leave empty if accessing directly via bucket endpoint
STORAGE_PUBLIC_URL=""

# ------------------------------------------------------------
# Option B: Vercel Blob Storage
# ------------------------------------------------------------
# If deploying on Vercel with Vercel Blob, setting this token
# enables Blob storage automatically without requiring S3 keys:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------
# Option C: Cloudinary (Developer-friendly with 25 GB free tier)
# ------------------------------------------------------------
# Find these in your Cloudinary Dashboard: https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"


