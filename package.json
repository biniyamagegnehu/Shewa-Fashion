{
  "name": "shewa-fashion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js",
    "db:generate": "npm run prisma -- generate",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:seed": "npm run prisma -- db seed",
    "db:verify": "tsx prisma/verify-db.ts",
    "test:catalog": "tsx scripts/test-catalog.ts",
    "db:studio": "npm run prisma -- studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "effect": "^3.21.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
